# Ollama / VLM
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
VLM_MODEL=qwen2.5vl:7b

# LLM behavior
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_SECONDS=1.5

# Janela do jogo (origem topo-esquerdo, em pixels)
# X/Y = "auto" centraliza a janela no monitor primário automaticamente.
# Setar valor numérico se quiser fixar (ex.: GAME_WINDOW_X=320).
GAME_WINDOW_X=auto
GAME_WINDOW_Y=auto
GAME_WINDOW_W=1280
GAME_WINDOW_H=720

# Diretórios (relativos à raiz do projeto)
FRAMES_DIR=frames
LOGS_DIR=logs
NOTES_DIR=notes

# Resize do screenshot enviado ao VLM (lado maior, px). 0 = desabilitado.
VLM_IMAGE_MAX_SIDE=768

# Gamepad virtual (vgamepad / ViGEm Bus driver). Tempos em segundos.
GAMEPAD_PRESS_HOLD_S=0.08
GAMEPAD_BETWEEN_ACTIONS_S=0.25
GAMEPAD_BOOT_DELAY_S=0.5
GAMEPAD_POST_DPAD_SETTLE_S=0.4
