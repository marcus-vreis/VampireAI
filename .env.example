# Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# Dois modelos, um por natureza de chamada.
#
# VLM_MODEL  -> chamadas COM imagem: transcrever uma carta nova, distinguir telas
#               de escolha. Precisa de visão; o que pesa aqui é OCR de documento.
# TEXT_MODEL -> chamadas SEM imagem: qual carta jogar, qual recompensa pegar.
#               É raciocínio e aritmética de mana, não visão. Mandar isso pro VLM
#               desperdiça duas vezes: a torre visual não contribui nada, e o
#               backbone de linguagem de um VLM é mais fraco que o de um modelo
#               de texto do mesmo tamanho.
#
# Vazio = usa o VLM pros dois (comportamento antigo, funciona).
#
# Cuidado com VRAM: se os dois não couberem residentes, o Ollama descarrega e
# recarrega a cada troca — ~30s por vez, o que destrói o orçamento de latência.
# Em 16GB, 8B + 8B (~12GB) é seguro; 8B + 14B (~15GB) é apertado. Precisa de
# OLLAMA_MAX_LOADED_MODELS=2 no ambiente do servidor.
#
# Não escolha por lista de blog: rode `python -m src.bench --models a,b` sobre o
# dataset rotulado e compare acurácia e latência na SUA tarefa.
VLM_MODEL=qwen2.5vl:7b
TEXT_MODEL=

# LLM behavior
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_SECONDS=1.5

# Janela do jogo (origem topo-esquerdo, em pixels)
# X/Y = "auto" centraliza a janela no monitor primário automaticamente.
# Setar valor numérico se quiser fixar (ex.: GAME_WINDOW_X=320).
GAME_WINDOW_X=auto
GAME_WINDOW_Y=auto
GAME_WINDOW_W=1280
GAME_WINDOW_H=720

# Diretórios (relativos à raiz do projeto)
FRAMES_DIR=frames
LOGS_DIR=logs
NOTES_DIR=notes

# Resize do screenshot enviado ao VLM (lado maior, px). 0 = desabilitado.
VLM_IMAGE_MAX_SIDE=768

# Gamepad virtual (vgamepad / ViGEm Bus driver). Tempos em segundos.
GAMEPAD_PRESS_HOLD_S=0.08
GAMEPAD_BETWEEN_ACTIONS_S=0.25
GAMEPAD_BOOT_DELAY_S=0.5
GAMEPAD_POST_DPAD_SETTLE_S=0.4

# Rotação dos frames de debug. Cada captura escreve ~500 KB e o agente captura
# várias vezes por passo: sem rotação, uma run de 1h escreve ~2.7 GB. 0 desliga.
FRAMES_KEEP=400
